<!DOCTYPE html>
<html>
  <head>
    <title>Blog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-black p-3">
      <div class="d-flex justify-content-between align-items-center w-100">
        <a class="navbar-brand text-white mx-1" href="#">
          Articles
        </a>

        <ul class="navbar-nav d-flex flex-row">
          <% if user_signed_in? %>
            <li>
              <div class="dropdown mx-1">
                <a class="btn btn-light dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
                  <%= current_user.full_name %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuLink">
                  <li><a class="dropdown-item" href="<%= user_path(current_user) %>">Personal Details</a></li>
                  <li><a class="dropdown-item" href="<%= edit_password_path(current_user) %>">Change Password</a></li>
                  <li>
                    <%= link_to 'Log out', destroy_user_session_path, class: "dropdown-item", data: { "turbo-method": :delete} %>
                  </li>
                </ul>
              </div>
            </li>
          <% else %>
            <li>
              <%= link_to 'Sign in', new_user_session_path, class: "btn btn-outline-success text-white mx-1" %> 
            </li>
            <li>
              <%= link_to 'Sign up', new_user_registration_path, class: "btn btn-outline-success text-white mx-1" %>
            </li>
          <% end %>
        </ul>
      </div>
    </nav>

    <main>
      <%= yield %>
    </main>

  </body>
</html>

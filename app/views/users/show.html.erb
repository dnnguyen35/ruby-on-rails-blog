<div class="bg-info mb-5">
  <h2 class=" container text-primary py-4 border-bottom ">
    <span>
      <a href="<%= root_path %>"><img src="<%= asset_path('chevron-left-solid.svg') %>" width="24" height="24"></a>
    </span>
    Personal Details
  </h2> 
</div>
<div class="container mb-3">
  <div class="my-2 mx-3" >
    <div class="d-flex justify-content-center rounded my-1">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, width: 100, height: 100, class: "rounded-circle" %>
      <% end %>
    </div>
  </div>
  <div class="d-flex justify-content-center">
    <a class=" btn btn-primary my-3 rounded-pill border  text-center bg-info text-decoration-none text-primary" href="#" id="change_avatar_btn">
      <strong>Change</strong>
    </a>
    <%= form_for(@user, url: change_avatar_path(@user), html: { id: "avatar_form", multipart: true }) do |f| %>
      <%= f.file_field :avatar, id: "avatar_file_field", accept: "image/*", class: "d-none" %>
    <% end %>
  </div>
</div>
<div class="container">
  <div class=" border-bottom my-2 mx-3" >
    <p><strong>Email</strong></p>
    <p class: "border rounded my-1"><%= @user.email %></p>
  </div>
  <div class=" border-bottom my-2 mx-3" >
    <p><strong>First name</strong></p>
    <p class: "border rounded my-1"><%= @user.first_name %></p>
  </div>
  <div class=" border-bottom my-2 mx-3" >
    <p><strong>Last name</strong></p>
    <p class: "border rounded my-1"><%= @user.last_name %></p>
  </div>
  <a class=" btn btn-primary my-3 rounded-pill border  text-center bg-info text-decoration-none text-primary" href="<%= edit_user_registration_path %>">
    <strong>Edit Details</strong>
  </a>
</div>

<%= javascript_include_tag('change_user_avatar.js') %>

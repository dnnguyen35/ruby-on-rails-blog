<div class="container">
    <div class="row mt-1">
      <div class="col-md-4 mx-auto">
        <h2 class="text-center">Sign Up</h2>
        
        <div class="form-container p-4 border rounded">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

            <div class="form-group my-3">
              <%= f.label :first_name %>
              <%= f.text_field :first_name, class: "form-control my-1", autofocus: true%>
              <% if resource.errors[:first_name].any? %>
                <div class="text-danger text-capitalize">
                  <%= resource.errors[:first_name].first %>
                </div>
              <% end %>
            </div>

            <div class="form-group my-3">
              <%= f.label :last_name %>
              <%= f.text_field :last_name, class: "form-control my-1"%>
              <% if resource.errors[:last_name].any? %>
                <div class="text-danger text-capitalize">
                  <%= resource.errors[:last_name].first %>
                </div>
              <% end %>
            </div>

            <div class="form-group my-3">
              <%= f.label :email %>
              <%= f.email_field :email, class: "form-control my-1", autocomplete: "email" %>
              <% if resource.errors[:email].any? %>
                <div class="text-danger text-capitalize">
                  <%= resource.errors[:email].first %>
                </div>
              <% end %>
            </div>
            
            <div class="form-group my-3">
              <%= f.label :password %>
              <%= f.password_field :password, class: "form-control my-1" %>
              <% if resource.errors[:password].any? %>
                <div class="text-danger text-capitalize">
                  <%= resource.errors[:password].first %>
                </div>
              <% end %>
            </div>

            <div class="form-group my-3">
              <%= f.label :password_confirmation %>
              <%= f.password_field :password_confirmation, class: "form-control my-1" %>
              <% if resource.errors[:password_confirmation].any? %>
                <div class="text-danger text-capitalize">
                  <%= resource.errors[:password_confirmation].first %>
                </div>
              <% end %>
            </div>
            
            <div class="form-group mt-5 mb-3">
              <%= f.submit "Sign Up", class: "btn btn-primary w-100" %>
            </div>
            <% end %>
        </div>
        
        <div class="form-container border rounded text-center mt-5 py-3">
          <p>Haved account? <span><%= link_to "Sign in", new_user_session_path, class: "text-decoration-none" %></span></p>
        </div>
      </div>
    </div>
  </div>

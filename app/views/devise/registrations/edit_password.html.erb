<div class="bg-info mb-5">
  <h2 class=" container text-primary py-4 border-bottom ">
    <span>
      <a href="<%= root_path %>"><img src="<%= asset_path('chevron-left-solid.svg') %>" width="24" height="24"></a>
    </span>
    Change Password
  </h2> 
</div>
<div class="container">
  <%= form_for(@user, as: resource_name, url: update_password_path(resource_name), html: { method: :patch, remote: true}) do |f| %>

    <div class="my-5 mx-3">
      <%= f.label :password %>
      <%= f.password_field :password, class: "form-control my-1", autofocus: true %>
      <% if resource.errors[:password].any? %>
        <div class="text-danger text-capitalize">
          <%= resource.errors[:password].first %>
        </div>
      <% end %>
    </div>

    <div class="my-5 mx-3">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, class: "form-control my-1" %>
      <% if resource.errors[:password_confirmation].any? %>
        <div class="text-danger text-capitalize">
          <%= resource.errors[:password_confirmation].first %>
        </div>
      <% end %>
    </div>

    <div class="my-5 mx-3">
      <%= f.label :current_password %>
      <%= f.password_field :current_password, class: "form-control my-1"%>
      <% if resource.errors[:current_password].any? %>
        <div class="text-danger text-capitalize">
          <%= resource.errors[:current_password].first %>
        </div>
      <% end %>
    </div>

    <div class="mt-5 mb-3">
      <%= f.submit "Change Password", class: "btn btn-primary bg-info border w-100 text-primary rounded-pill" %>
    </div>
  <% end %>
</div>
    
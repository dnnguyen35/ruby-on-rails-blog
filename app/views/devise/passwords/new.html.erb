<div class="container">
  <div class="row mt-1">
    <div class="col-md-4 mx-auto">
      <h2 class="text-center">Your Email</h2>
      
      <div class="form-container p-4 border rounded">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>

          <div class="form-group my-3">
            <%= f.label :email %>
            <%= f.email_field :email, class: "form-control my-1", autofocus: true, autocomplete: "email" %>
            <% if resource.errors[:email].any? %>
              <div class="text-danger text-capitalize">
                <%= resource.errors[:email].first %>
              </div>
            <% end %>
          </div>
          
          <div class="form-group mt-5 mb-3">
            <%= f.submit "Get Instructions", class: "btn btn-primary w-100" %>
          </div>
        <% end %>
      </div>

      <div class="form-container border rounded text-center mt-5 py-3">
        <p>New to Blog?<span><%= link_to "Create new account", new_user_registration_path, class: "text-decoration-none" %></span></p>
        <p>Haved account?<span><%= link_to "Sign up", new_user_session_path, class: "text-decoration-none" %></span></p>
      </div>
    </div>
  </div>
</div>

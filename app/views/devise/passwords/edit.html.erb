<div class="container">
  <div class="row mt-1">
    <div class="col-md-4 mx-auto">
      <h2 class="text-center">Reset Password</h2>
      
      <div class="form-container p-4 border rounded">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          
          <%= f.hidden_field :reset_password_token %>

          <div class="form-group my-3">
            <%= f.label :password, "New Password" %>
            <%= f.password_field :password, class: "form-control my-1", autofocus: true %>
            <% if resource.errors[:password].any? %>
              <div class="text-danger text-capitalize">
                <%= resource.errors[:password].first %>
              </div>
            <% end %>
          </div>

          <div class="form-group my-3">
            <%= f.label :password_confirmation, "New Password Comfirmation" %>
            <%= f.password_field :password_confirmation, class: "form-control my-1" %>
            <% if resource.errors[:password_confirmation].any? %>
              <div class="text-danger text-capitalize">
                <%= resource.errors[:password_confirmation].first %>
              </div>
            <% end %>
          </div>
          
          <div class="form-group mt-5 mb-3">
            <%= f.submit "Change Password", class: "btn btn-primary w-100" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
